<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tv_nombre_marca"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/garceran_babees"
        android:textColor="#1A1C1E"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />


    <TextView
        android:id="@+id/tv_slogan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_slogan"
        android:textColor="#1A1C1E"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tv_nombre_marca"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="2dp" />


    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="56dp"
        android:src="@drawable/ic_logo"
        android:contentDescription="@string/desc_logo"
        app:layout_constraintBottom_toBottomOf="@id/tv_slogan"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_nombre_marca"
        app:layout_constraintVertical_bias="0.0" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_registro"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="@string/tv_registrarse"
        android:textSize="12sp"
        android:backgroundTint="#E6E0F8"
        android:textColor="#1A1C1E"
        app:cornerRadius="100dp"
        app:icon="@drawable/ic_registrame"
        app:iconTint="#1A1C1E"
        app:layout_constraintTop_toBottomOf="@id/tv_slogan"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="12dp" />

    <!-- 2. BOTÓN CATÁLOGO -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_catalogo"
        android:layout_width="160dp"
        android:layout_height="51dp"
        android:text="@string/catalogo"
        android:textSize="14sp"
        android:backgroundTint="#00629E"
        android:textColor="#FFFFFF"
        android:padding="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="15dp"
        app:layout_constraintTop_toBottomOf="@id/btn_registro"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_novedades"
        android:layout_width="375dp"
        android:layout_height="380dp"
        app:cardBackgroundColor="#CFE5FF"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/btn_catalogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tv_novedades_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tv_novedades"
                android:textColor="#1A1C1E"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_conjunto_invierno"
                android:layout_width="178dp"
                android:layout_height="256dp"
                app:cardBackgroundColor="#F8EBEB"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/tv_novedades_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="10dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Foto del producto -->
                    <ImageView
                        android:id="@+id/iv_conjunto_invierno"
                        android:layout_width="0dp"
                        android:layout_height="145dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_conjunto_invierno"
                        android:contentDescription="@string/desc_producto"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <ImageView
                        android:id="@+id/iv_favorito"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_favoritos"
                        android:contentDescription="@string/desc_favorito"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginEnd="8dp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tv_nombre_producto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tv_conjunto_invierno"
                        android:textColor="#1A1C1E"
                        android:textSize="14sp"
                        app:layout_constraintTop_toBottomOf="@id/iv_conjunto_invierno"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:id="@+id/tv_precio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tv_precio"
                        android:textColor="#1A1C1E"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toBottomOf="@id/tv_nombre_producto"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="4dp" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="#EFEFEF"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_nav_inicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/ic_inicio"
            android:contentDescription="@string/desc_inicio" />

        <ImageView
            android:id="@+id/iv_nav_grid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/ic_catalogo"
            android:contentDescription="@string/desc_nav_catalogo" />

        <ImageView
            android:id="@+id/iv_nav_perfil"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/ic_perfil"
            android:contentDescription="@string/desc_perfil" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>